generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ---------- Cliente ----------
model Customer {
  id             String    @id @default(cuid())
  name           String
  phone          String    @unique
  email          String?
  address        String    @default("")
  latitude       Float?
  longitude      Float?
  // "exata" = capturada no local exacto de entrega (cadastro)
  // "auto"  = detectada automaticamente (provisória)
  // "atualizada" = recapturada depois do cadastro
  locationSource String    @default("auto")
  locationNote   String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  orders         Order[]
  feedbacks      Feedback[]
}

// ---------- Produto ----------
model Product {
  id          String      @id @default(cuid())
  name        String
  description String      @default("")
  // "agua" | "acessorio"
  category    String      @default("agua")
  // "bidon" | "garrafao" | "garrafa" | "pack" | "acessorio"
  kind        String      @default("bidon")
  volumeL     Float       @default(0)
  priceKz     Float
  unitLabel   String      @default("")
  stock       Int         @default(100)
  active      Boolean     @default(true)
  sortOrder   Int         @default(0)
  createdAt   DateTime    @default(now())
  orderItems  OrderItem[]
}

// ---------- Motoboy (Entregador) ----------
model Courier {
  id        String   @id @default(cuid())
  name      String
  phone     String   @default("")
  vehicle   String   @default("Mota")
  plate     String   @default("")
  latitude  Float?
  longitude Float?
  available Boolean  @default(true)
  createdAt DateTime @default(now())
  orders    Order[]
}

// ---------- Pedido ----------
model Order {
  id            String      @id @default(cuid())
  number        Int         @unique
  customerId    String
  customer      Customer    @relation(fields: [customerId], references: [id])
  items         OrderItem[]
  totalKz       Float       @default(0)
  totalLiters   Float       @default(0)
  // "TPA" | "CASH"
  paymentMethod String      @default("CASH")
  // "pendente" | "confirmado" | "em_transito" | "entregue" | "cancelado"
  status        String      @default("pendente")
  notes         String?
  address       String      @default("")
  latitude      Float?
  longitude     Float?
  courierId     String?
  courier       Courier?    @relation(fields: [courierId], references: [id])
  // Gestão de tempo: momento que pediu e que recebeu
  requestedAt   DateTime    @default(now())
  confirmedAt   DateTime?
  dispatchedAt  DateTime?
  deliveredAt   DateTime?
  cancelledAt   DateTime?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
}

// ---------- Item do Pedido ----------
model OrderItem {
  id          String  @id @default(cuid())
  orderId     String
  order       Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId   String
  product     Product @relation(fields: [productId], references: [id])
  productName String
  unitLabel   String  @default("")
  unitPriceKz Float
  quantity    Int
  volumeL     Float   @default(0)
}

// ---------- Sugestões e Reclamações ----------
model Feedback {
  id          String    @id @default(cuid())
  customerId  String?
  customer    Customer? @relation(fields: [customerId], references: [id])
  // "sugestao" | "reclamacao"
  type        String
  subject     String
  message     String
  // "aberto" | "respondido"
  status      String    @default("aberto")
  response    String?
  respondedAt DateTime?
  createdAt   DateTime  @default(now())
}

# ============================================================
#  Gota REAL — variáveis de ambiente
#  Copie este ficheiro para .env e ajuste os valores.
#  NUNCA commitar o .env real (já está no .gitignore).
# ============================================================

# --- BASE DE DADOS (obrigatório) -------------------------------------------
# Local (desenvolvimento, SQLite):
DATABASE_URL="file:./db/custom.db"
#
# Produção (Vercel + Postgres): cole aqui a connection string do
# Vercel Postgres / Neon / Supabase, por exemplo:
# DATABASE_URL="postgresql://usuario:senha@ep-xxx.eu-central-1.aws.neon.tech/gota_real?sslmode=require"
#
# NOTA: o esquema usado é escolhido automaticamente —
#   file:…        → prisma/schema.local.prisma  (SQLite, dev)
#   postgresql:…  → prisma/schema.prisma        (Postgres, produção)

# --- TEMPO REAL (opcional) --------------------------------------------------
# WebSockets instantâneos. Sem esta variável:
#   - em desenvolvimento liga ao serviço local (porta 3003)
#   - na produção (Vercel) a app usa POLLING automático de reserva
# Para apontar a um serviço dedicado no futuro:
# NEXT_PUBLIC_REALTIME_URL="https://o-seu-servico-de-sockets.com"
# Para desligar por completo:
# NEXT_PUBLIC_REALTIME_URL="disabled"
